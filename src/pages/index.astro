---
import { Icon } from "astro-icon/components";
import Meteors from "@/components/Meteors.astro";
import SocialList from "@/components/SocialList.astro";
import LandingLayout from "@/layouts/Landing.astro";

interface SkillItem {
	name: string;
	icon: string;
	color?: string;
	delay: string;
	duration: string;
}

const skills: SkillItem[] = [
	{ name: "pfSense", icon: "simple-icons:pfsense", color: "#ffffff", delay: "0s", duration: "4s" },
	{ name: "Wazuh SIEM", icon: "wazuh", delay: "1.2s", duration: "4.8s" },
	{ name: "Docker", icon: "simple-icons:docker", delay: "0.5s", duration: "5.2s" },
	{ name: "Kali Linux", icon: "kali-linux", delay: "1.7s", duration: "4.6s" },
	{ name: "Bash Scripting", icon: "simple-icons:gnubash", delay: "0.3s", duration: "5s" },
	{ name: "PowerShell Scripting", icon: "powershell", delay: "0.3s", duration: "5s" },
	{ name: "Git", icon: "simple-icons:git", delay: "2.5s", duration: "4.2s" },
	{ name: "GitHub", icon: "simple-icons:github", delay: "1.1s", duration: "5.4s" },
	{ name: "Astro", icon: "simple-icons:astro", delay: "1.9s", duration: "4.7s" },
	{ name: "Markdown", icon: "simple-icons:markdown", color: "#ffffff", delay: "0.6s", duration: "5.1s" },
	{ name: "LaTeX", icon: "simple-icons:latex", delay: "1.4s", duration: "4.9s" },
	{ name: "Python", icon: "simple-icons:python", delay: "1.4s", duration: "4.9s" },
	{ name: "TrueNAS", icon: "simple-icons:truenas", delay: "1.4s", duration: "4.9s" },
	{ name: "Cisco Packet Tracer", icon: "cisco", delay: "1.4s", duration: "4.9s" },
];

const tools: SkillItem[] = [
	{ name: "Antigravity", icon: "antigravity-color", delay: "0.2s", duration: "4.5s" },
	{ name: "VirtualBox", icon: "simple-icons:virtualbox", delay: "1.5s", duration: "5.3s" },
	{ name: "Ubuntu Server", icon: "simple-icons:ubuntu", delay: "0.9s", duration: "4.7s" },
	{ name: "Windows Server", icon: "windows-1", delay: "2.3s", duration: "5.1s" },
	{ name: "Git CLI", icon: "simple-icons:git", delay: "1.8s", duration: "4.3s" },
];
---

<LandingLayout meta={{ title: "Portfolio" }}>
	<!-- ═══════════════════════════════════════════════ -->
	<!-- HERO — Pantalla completa                       -->
	<!-- ═══════════════════════════════════════════════ -->
	<section
		class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-4 text-center"
		id="hero"
	>
		<!-- Fondo de Meteoritos estilo Magic UI -->
		<Meteors number={30} />

		<div class="relative z-10 max-w-2xl">
			<!-- Subtítulo con entrada escalonada y hover interactivo -->
			<p class="text-accent mb-3 text-sm font-semibold uppercase tracking-widest cursor-default group hero-subtitle">
				<span class="inline-block hover:text-link hover:scale-105 transition-all opacity-0 translate-y-4">Administración de Sistemas</span>
				<span class="mx-1 opacity-0">·</span>
				<span class="inline-block hover:text-link hover:scale-105 transition-all opacity-0 translate-y-4">Redes</span>
				<span class="mx-1 opacity-0">·</span>
				<span class="inline-block hover:text-link hover:scale-105 transition-all opacity-0 translate-y-4">Seguridad</span>
			</p>
			
			<!-- Título con efecto de máquina de escribir y hover resplandeciente -->
			<h1 class="mb-6 text-4xl font-bold sm:text-5xl md:text-6xl min-h-[40px] sm:min-h-[60px]">
				<span 
					id="typewriter-name" 
					class="text-accent-2 inline-block cursor-default border-r-4 border-accent pr-2 hover-glow"
				></span>
			</h1>
			<p class="text-muted mx-auto mb-8 max-w-lg text-base leading-relaxed sm:text-lg">
				Técnico en ASIR. Construyo y documento infraestructuras de red seguras, despliegues
				con Docker y sistemas de monitorización.
			</p>

			<!-- Botonera CTA Principal -->
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10 hero-cta">
				<a href="/proyectos/" class="opacity-0 translate-y-4 bg-accent text-[#1d1f21] hover:brightness-110 px-6 py-3 rounded-md font-bold transition-all hover:scale-105 flex items-center gap-2 shadow-[0_0_15px_rgba(42,188,137,0.3)] hover:shadow-[0_0_20px_rgba(42,188,137,0.5)]">
					<Icon name="mdi:book-open-page-variant" class="h-5 w-5" />
					Explorar Mi Wiki
				</a>
				<a href="#contacto" class="opacity-0 translate-y-4 border border-accent/30 text-accent hover:bg-accent/10 px-6 py-3 rounded-md font-semibold transition-colors">
					Contactar
				</a>
			</div>

			<SocialList />
		</div>

		<!-- Flecha de scroll -->
		<a
			aria-label="Ir a la sección sobre mí"
			class="text-muted hover:text-accent absolute bottom-10 animate-bounce transition-colors"
			href="#sobre-mi"
		>
			<svg
				class="h-8 w-8"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				viewBox="0 0 24 24"
			>
				<path d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	</section>

	<script is:inline>
		// Lógica del efecto Máquina de Escribir
		const runTypewriter = () => {
			const nameEl = document.getElementById('typewriter-name');
			if (!nameEl) return;
			
			// Evitar múltiples ejecuciones concurrentes al recargar la página con View Transitions
			if (nameEl.hasAttribute('data-typing')) return;
			nameEl.setAttribute('data-typing', 'true');
			
			const text = "Pablo Calderón";
			let i = 0;
			let isDeleting = false;
			nameEl.textContent = ""; // Limpiar texto al iniciar
			
			// Añadir clase de parpadeo del cursor
			nameEl.classList.add('animate-[blink_0.8s_step-end_infinite]');

			const type = () => {
				// Detener la ejecución si el elemento ya no existe (por si el usuario navega a otra página)
				if (!nameEl.isConnected) return;

				if (isDeleting) {
					// Borrando
					nameEl.textContent = text.substring(0, i - 1);
					i--;
				} else {
					// Escribiendo
					nameEl.textContent = text.substring(0, i + 1);
					i++;
				}

				// Velocidades base: 80ms escribir, 40ms borrar (más rápido)
				let typingSpeed = isDeleting ? 40 : 80;

				if (!isDeleting && i === text.length) {
					// Cuando termina de escribir, espera 8 segundos antes de empezar a borrar
					typingSpeed = 4000; 
					isDeleting = true;
				} else if (isDeleting && i === 0) {
					// Cuando termina de borrar, espera medio segundo antes de volver a escribir
					isDeleting = false;
					typingSpeed = 500;
				}

				setTimeout(type, typingSpeed);
			};

			// Retraso inicial antes de empezar
			setTimeout(type, 500); 
		};

		// Ejecutar al cargar (compatible con View Transitions)
		document.addEventListener('astro:page-load', runTypewriter);
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', runTypewriter);
		} else {
			runTypewriter();
		}
	</script>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- SOBRE MÍ                                       -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="mx-auto max-w-3xl scroll-mt-32 px-4 py-24 sm:px-8" id="sobre-mi">
		<h2 class="title mb-8 text-xl reveal">Sobre mí</h2>
		
		<!-- Header de Impacto -->
		<div class="reveal mb-12">
			<h3 class="text-2xl md:text-3xl font-bold text-accent-2 leading-tight">
				Administrador de Sistemas enfocado en el despliegue de infraestructuras seguras, automatización y defensa perimetral.
			</h3>
		</div>

		<!-- Layout de 2 Columnas -->
		<div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16">
			
			<!-- Columna Izquierda: Historia Profesional (60-70%) -->
			<div class="md:col-span-7 lg:col-span-8 flex flex-col gap-6 reveal">
				<div class="prose prose-sm md:prose-base prose-cactus max-w-none text-muted leading-relaxed">
					<p>
						¡Hola! <strong>Soy Pablo, Graduado en Administración de Sistemas Informáticos en Red (ASIR).</strong> Desde mis inicios, siempre me ha apasionado comprender cómo fluyen los datos y cómo construir cimientos tecnológicos sólidos. Cuento con experiencia práctica administrando sistemas y asegurando la continuidad del negocio.
					</p>
					<p>
						Me especializo en diseñar entornos de red segmentados mediante VLANs, implementar cortafuegos perimetrales con pfSense y fortificar servidores mediante la monitorización y análisis de eventos con Wazuh. Además, disfruto orquestando despliegues ágiles utilizando contenedores Docker.
					</p>
					<p>
						Actualmente sigo ampliando mis conocimientos: me encuentro preparándome activamente para certificaciones clave de la industria como <strong>Cisco CCNA</strong> y <strong>CompTIA Security+</strong>. Mi gran objetivo es consolidar mi carrera como analista e ingeniero de Ciberseguridad.
					</p>
				</div>
				
				<!-- Soft Skills minimalistas (Opcional, pero útil) -->
				<div class="flex flex-wrap gap-3 mt-2">
					<span class="inline-flex items-center gap-1.5 rounded bg-accent/10 px-2.5 py-1 text-xs font-medium text-accent-2 border border-accent/20">Trabajo en equipo</span>
					<span class="inline-flex items-center gap-1.5 rounded bg-accent/10 px-2.5 py-1 text-xs font-medium text-accent-2 border border-accent/20">Resiliencia</span>
					<span class="inline-flex items-center gap-1.5 rounded bg-accent/10 px-2.5 py-1 text-xs font-medium text-accent-2 border border-accent/20">Resolución de problemas</span>
				</div>
			</div>

			<!-- Columna Derecha: Elemento Visual de Conversión (30-40%) -->
			<div class="md:col-span-5 lg:col-span-4 reveal relative">
				<div 
					class="relative overflow-hidden border border-accent/20 hover:border-accent group rounded-xl bg-accent/5 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg flex flex-col h-full min-h-[280px]"
				>
					<!-- Terminal Header -->
					<div class="flex items-center gap-2 px-4 py-3 bg-black/40 border-b border-accent/10">
						<div class="flex gap-1.5">
							<div class="w-3 h-3 rounded-full bg-red-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-green-500/80"></div>
						</div>
						<div class="mx-auto text-[10px] font-mono text-muted">pablo@portfolio:~</div>
					</div>
					<!-- Terminal Body -->
					<div class="p-5 font-mono text-xs flex-grow flex flex-col justify-center relative z-20">
						<div class="text-accent-2 mb-2"><span class="text-emerald-400">pablo@portfolio</span>:<span class="text-blue-400">~</span>$ whoami</div>
						<div class="text-muted mb-6 pl-2 opacity-80 group-hover:opacity-100 transition-opacity space-y-1">
							<div>> SysAdmin</div>
							<div>> Técnico de Redes</div>
							<div>> Ciberseguridad</div>
						</div>
						
						<a href="/cv_pablo_calderon.pdf" target="_blank" rel="noopener noreferrer" class="shimmer-btn mt-auto pointer-events-auto bg-accent/10 hover:bg-accent/20 text-accent border border-accent/20 rounded-md px-4 py-2.5 text-xs font-semibold flex items-center justify-center gap-2 transition-all duration-300 hover:scale-[1.02]">
							<Icon name="mdi:download" class="h-4 w-4" />
							Descargar Currículum
						</a>
					</div>
					<!-- Decorative Background Matrix/Lines -->
					<div class="absolute inset-0 opacity-5 bg-[linear-gradient(rgba(42,188,137,0.2)_1px,transparent_1px)] bg-[length:100%_4px] pointer-events-none"></div>
				</div>
			</div>
		</div>

		<!-- Línea de tiempo de Formación (Roadmap) -->
		<div class="relative overflow-hidden mt-8 border border-accent/20 hover:border-accent group rounded-xl p-6 md:p-8 bg-accent/5 backdrop-blur-sm mb-16 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
			
			<h3 class="relative z-10 text-sm font-bold text-accent uppercase tracking-widest mb-8 flex items-center gap-2">
				<Icon name="mdi:map-marker-path" class="h-5 w-5" />
				Formación & Ruta Profesional
			</h3>
			
			<div class="relative z-10 border-l-2 border-accent/20 ml-3 md:ml-4 space-y-8">
				
				<!-- Hito 1: ASIR -->
				<div class="relative pl-6 md:pl-8 reveal">
					<div class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-emerald-400 ring-4 ring-[#1d1f21] shadow-[0_0_10px_rgba(42,188,137,0.8)]"></div>
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
						<h4 class="text-base font-semibold text-accent-2">Técnico Superior en ASIR</h4>
						<span class="inline-flex items-center w-max px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase tracking-wider">
							Completado
						</span>
					</div>
					<p class="text-sm text-muted">Administración de Sistemas Informáticos en Red. Base sólida en sistemas operativos, servicios de red y seguridad estructural.</p>
				</div>

				<!-- Hito 2: B2 -->
				<div class="relative pl-6 md:pl-8 reveal">
					<div class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-emerald-400 ring-4 ring-[#1d1f21] shadow-[0_0_10px_rgba(42,188,137,0.8)]"></div>
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
						<h4 class="text-base font-semibold text-accent-2">B2 Cambridge English</h4>
						<span class="inline-flex items-center w-max px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase tracking-wider">
							Completado
						</span>
					</div>
					<p class="text-sm text-muted">Certificación de nivel intermedio-alto de inglés, vital para la lectura y comprensión de documentación técnica.</p>
				</div>

				<!-- Hito 3: Cisco / CompTIA -->
				<div class="relative pl-6 md:pl-8 reveal">
					<div class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-yellow-400 ring-4 ring-[#1d1f21] shadow-[0_0_10px_rgba(250,204,21,0.8)]"></div>
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
						<h4 class="text-base font-semibold text-accent-2">Cisco CCNA & CompTIA Security+</h4>
						<span class="inline-flex items-center w-max px-2 py-0.5 rounded text-[10px] font-bold bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 uppercase tracking-wider">
							Estudiando Actual
						</span>
					</div>
					<p class="text-sm text-muted">Preparación activa para la certificación líder en redes (Cisco) y la certificación base en ciberseguridad (CompTIA).</p>
				</div>

				<!-- Hito 4: Ciberseguridad -->
				<div class="relative pl-6 md:pl-8 reveal">
					<div class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-blue-400 ring-4 ring-[#1d1f21] shadow-[0_0_10px_rgba(96,165,250,0.8)]"></div>
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
						<h4 class="text-base font-semibold text-accent-2">Curso Especialización Ciberseguridad</h4>
						<span class="inline-flex items-center w-max px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20 uppercase tracking-wider">
							Meta Futura
						</span>
					</div>
					<p class="text-sm text-muted">Próximo paso tras consolidar las bases, con enfoque en el hacking ético, análisis forense y seguridad de los entornos de la información.</p>
				</div>

			</div>
		</div>

		<!-- ═══════════════════════════════════════════════ -->
		<!-- TECNOLOGÍAS & HERRAMIENTAS (Skillset)          -->
		<!-- ═══════════════════════════════════════════════ -->
		<div class="mt-20 reveal">
			<div class="text-center mb-10">
				<h3 class="text-xl font-bold text-accent-2 mb-2">Tecnologías & Skills</h3>
				<p class="text-xs text-muted">Algunas de las tecnologías e infraestructuras con las que trabajo</p>
			</div>
			
			<!-- Habilidades flotantes -->
			<div class="flex flex-wrap items-center justify-center gap-4.5 max-w-2xl mx-auto mb-16">
				{
					skills.map((skill) => {
						const isSimpleIcon = skill.icon.startsWith("simple-icons:");
						const simpleIconSlug = isSimpleIcon ? skill.icon.replace("simple-icons:", "") : "";
						const needsInvert = ["github", "latex", "pfsense", "markdown"].includes(simpleIconSlug);
						
						return (
							<div
								class="floating-pill flex items-center gap-2.5 px-4.5 py-2 rounded-full border border-accent/20 bg-accent/5 backdrop-blur-sm hover:border-accent hover:shadow-[0_0_15px_rgba(42,188,137,0.25)] hover:scale-105 transition-all duration-300 cursor-default"
								style={`animation-delay: ${skill.delay}; animation-duration: ${skill.duration};`}
								data-cursor="-pointer"
							>
								{isSimpleIcon ? (
									<img
										src={`https://cdn.simpleicons.org/${simpleIconSlug}`}
										class={`h-5.5 w-5.5 object-contain ${needsInvert ? "dark:brightness-0 dark:invert" : ""}`}
										alt=""
										onerror="this.onerror=null; this.src='https://api.iconify.design/mdi/code-braces.svg?color=%232bbc8a';"
									/>
								) : (
									<Icon name={skill.icon} class="h-5.5 w-5.5" style={skill.color ? `color: ${skill.color}` : ""} />
								)}
								<span class="text-sm font-semibold text-accent-2">{skill.name}</span>
							</div>
						);
					})
				}
			</div>

			<div class="text-center mb-10">
				<h3 class="text-xl font-bold text-accent-2 mb-2">Mi stack tecnológico</h3>
				<p class="text-xs text-muted">El software y herramientas que utilizo en mi día a día</p>
			</div>

			<!-- Herramientas flotantes -->
			<div class="flex flex-wrap items-center justify-center gap-4.5 max-w-2xl mx-auto">
				{
					tools.map((tool) => {
						const isSimpleIcon = tool.icon.startsWith("simple-icons:");
						const simpleIconSlug = isSimpleIcon ? tool.icon.replace("simple-icons:", "") : "";
						const needsInvert = ["github", "latex", "pfsense", "markdown"].includes(simpleIconSlug);
						
						return (
							<div
								class="floating-pill flex items-center gap-2.5 px-4.5 py-2 rounded-full border border-accent/20 bg-accent/5 backdrop-blur-sm hover:border-accent hover:shadow-[0_0_15px_rgba(42,188,137,0.25)] hover:scale-105 transition-all duration-300 cursor-default"
								style={`animation-delay: ${tool.delay}; animation-duration: ${tool.duration};`}
								data-cursor="-pointer"
							>
								{isSimpleIcon ? (
									<img
										src={`https://cdn.simpleicons.org/${simpleIconSlug}`}
										class={`h-5.5 w-5.5 object-contain ${needsInvert ? "dark:brightness-0 dark:invert" : ""}`}
										alt=""
										onerror="this.onerror=null; this.src='https://api.iconify.design/mdi/robot-outline.svg?color=%232bbc8a';"
									/>
								) : (
									<Icon name={tool.icon} class="h-5.5 w-5.5" style={tool.color ? `color: ${tool.color}` : ""} />
								)}
								<span class="text-sm font-semibold text-accent-2">{tool.name}</span>
							</div>
						);
					})
				}
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- PROYECTOS DESTACADOS                            -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="mx-auto max-w-3xl scroll-mt-32 px-4 py-24 sm:px-8" id="proyectos">
		<h2 class="title mb-4 text-xl reveal">Proyectos Destacados</h2>
		<p class="text-muted mb-10 text-sm reveal">
			Una selección de mis proyectos e implementaciones de sistemas más destacadas, con su respectiva documentación técnica detallada en Starlight.
		</p>

		<div class="space-y-6">
			<!-- Proyecto: TFG -->
			<article
				class="reveal relative overflow-hidden border-accent/20 hover:border-accent group rounded-md border p-5 transition-all duration-150 hover:-translate-y-1 hover:shadow-lg cursor-pointer"
				onclick="window.location.href='/proyectos/tfg-fortificacion-pyme/'"
				data-cursor="-pointer"
			>
				<div class="relative z-10">
					<div class="mb-2 flex flex-wrap items-center gap-2">
						<h3 class="text-base font-semibold">
							<a class="cactus-link" href="/proyectos/tfg-fortificacion-pyme/">
								Marco de Seguridad para PYMES
							</a>
						</h3>
						<span class="rounded-full bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
							Completado
						</span>
					</div>
					<p class="text-muted mb-3 text-sm">
						Diseño e implementación de una infraestructura de red corporativa segura utilizando pfSense, segmentación de VLAN, configuración de reglas Firewall y monitorización con Wazuh.
					</p>
					<div class="flex flex-wrap gap-1.5">
						{["pfSense", "VLANs", "Firewall", "Wazuh"].map((tag) => (
							<span class="bg-accent/10 text-accent rounded-md px-2 py-0.5 text-xs">{tag}</span>
						))}
					</div>
				</div>
			</article>

			<!-- Proyecto: Portfolio -->
			<article
				class="reveal relative overflow-hidden border-accent/20 hover:border-accent group rounded-md border p-5 transition-all duration-150 hover:-translate-y-1 hover:shadow-lg cursor-pointer"
				onclick="window.location.href='/proyectos/desarrollo-portfolio/'"
				data-cursor="-pointer"
			>
				<div class="relative z-10">
					<div class="mb-2 flex flex-wrap items-center gap-2">
						<h3 class="text-base font-semibold">
							<a class="cactus-link" href="/proyectos/desarrollo-portfolio/">
