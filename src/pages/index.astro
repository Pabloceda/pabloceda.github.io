---
import { Icon } from "astro-icon/components";
import Meteors from "@/components/Meteors.astro";
import SocialList from "@/components/SocialList.astro";
import LandingLayout from "@/layouts/Landing.astro";

interface SkillItem {
	name: string;
	icon: string;
	color?: string;
	delay: string;
	duration: string;
}

const skills: SkillItem[] = [
	{ name: "pfSense", icon: "simple-icons:pfsense", color: "#ffffff", delay: "0s", duration: "4s" },
	{ name: "Wazuh SIEM", icon: "wazuh", delay: "1.2s", duration: "4.8s" },
	{ name: "Docker", icon: "simple-icons:docker", delay: "0.5s", duration: "5.2s" },
	{ name: "Kali Linux", icon: "kali-linux", delay: "1.7s", duration: "4.6s" },
	{ name: "Bash Scripting", icon: "simple-icons:gnubash", delay: "0.3s", duration: "5s" },
	{ name: "PowerShell Scripting", icon: "powershell", delay: "0.3s", duration: "5s" },
	{ name: "Git", icon: "simple-icons:git", delay: "2.5s", duration: "4.2s" },
	{ name: "GitHub", icon: "simple-icons:github", delay: "1.1s", duration: "5.4s" },
	{ name: "Astro", icon: "simple-icons:astro", delay: "1.9s", duration: "4.7s" },
	{
		name: "Markdown",
		icon: "simple-icons:markdown",
		color: "#ffffff",
		delay: "0.6s",
		duration: "5.1s",
	},
	{ name: "LaTeX", icon: "simple-icons:latex", delay: "1.4s", duration: "4.9s" },
	{ name: "Python", icon: "simple-icons:python", delay: "1.4s", duration: "4.9s" },
	{ name: "TrueNAS", icon: "simple-icons:truenas", delay: "1.4s", duration: "4.9s" },
	{ name: "Cisco Packet Tracer", icon: "cisco", delay: "1.4s", duration: "4.9s" },
];

const tools: SkillItem[] = [
	{ name: "Antigravity", icon: "antigravity-color", delay: "0.2s", duration: "4.5s" },
	{ name: "VirtualBox", icon: "simple-icons:virtualbox", delay: "1.5s", duration: "5.3s" },
	{ name: "Ubuntu Server", icon: "simple-icons:ubuntu", delay: "0.9s", duration: "4.7s" },
	{ name: "Windows Server", icon: "windows-1", delay: "2.3s", duration: "5.1s" },
	{ name: "Git CLI", icon: "simple-icons:git", delay: "1.8s", duration: "4.3s" },
];
---

<LandingLayout meta={{ title: "Portfolio" }}>
	<!-- ═══════════════════════════════════════════════ -->
	<!-- HERO — Pantalla completa                       -->
	<!-- ═══════════════════════════════════════════════ -->
	<section
		class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-4 text-center"
		id="hero"
	>
		<!-- Fondo de Meteoritos estilo Magic UI -->
		<Meteors number={30} />

		<div class="relative z-10 max-w-2xl">
			<!-- Subtítulo con entrada escalonada y hover interactivo -->
			<p
				class="text-accent group hero-subtitle mb-3 cursor-default text-sm font-semibold tracking-widest uppercase"
			>
				<span
					class="hover:text-link inline-block translate-y-4 opacity-0 transition-all hover:scale-105"
					>Administración de Sistemas</span
				>
				<span class="mx-1 opacity-0">·</span>
				<span
					class="hover:text-link inline-block translate-y-4 opacity-0 transition-all hover:scale-105"
					>Redes</span
				>
				<span class="mx-1 opacity-0">·</span>
				<span
					class="hover:text-link inline-block translate-y-4 opacity-0 transition-all hover:scale-105"
					>Seguridad</span
				>
			</p>

			<!-- Título con efecto de máquina de escribir y hover resplandeciente -->
			<h1 class="mb-6 min-h-[40px] text-4xl font-bold sm:min-h-[60px] sm:text-5xl md:text-6xl">
				<span
					id="typewriter-name"
					class="text-accent-2 border-accent hover-glow inline-block cursor-default border-r-4 pr-2"
				></span>
			</h1>
			<p class="text-muted mx-auto mb-8 max-w-lg text-base leading-relaxed sm:text-lg">
				Técnico en ASIR. Construyo y documento infraestructuras de red seguras, despliegues con
				Docker y sistemas de monitorización.
			</p>

			<!-- Botonera CTA Principal -->
			<div class="hero-cta mb-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
				<a
					href="/proyectos/"
					class="bg-accent flex translate-y-4 items-center gap-2 rounded-md px-6 py-3 font-bold text-[#1d1f21] opacity-0 shadow-[0_0_15px_rgba(42,188,137,0.3)] transition-all hover:scale-105 hover:shadow-[0_0_20px_rgba(42,188,137,0.5)] hover:brightness-110"
				>
					<Icon name="mdi:book-open-page-variant" class="h-5 w-5" />
					Explorar Mi Wiki
				</a>
				<a
					href="#contacto"
					class="border-accent/30 text-accent hover:bg-accent/10 translate-y-4 rounded-md border px-6 py-3 font-semibold opacity-0 transition-colors"
				>
					Contactar
				</a>
			</div>

			<SocialList />
		</div>

		<!-- Flecha de scroll -->
		<a
			aria-label="Ir a la sección sobre mí"
			class="text-muted hover:text-accent absolute bottom-10 animate-bounce transition-colors"
			href="#sobre-mi"
		>
			<svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
				<path
					d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</section>

	<script is:inline>
		// Lógica del efecto Máquina de Escribir
		const runTypewriter = () => {
			const nameEl = document.getElementById("typewriter-name");
			if (!nameEl) return;

			// Evitar múltiples ejecuciones concurrentes al recargar la página con View Transitions
			if (nameEl.hasAttribute("data-typing")) return;
			nameEl.setAttribute("data-typing", "true");

			const text = "Pablo Calderón";
			let i = 0;
			let isDeleting = false;
			nameEl.textContent = ""; // Limpiar texto al iniciar

			// Añadir clase de parpadeo del cursor
			nameEl.classList.add("animate-[blink_0.8s_step-end_infinite]");

			const type = () => {
				// Detener la ejecución si el elemento ya no existe (por si el usuario navega a otra página)
				if (!nameEl.isConnected) return;

				if (isDeleting) {
					// Borrando
					nameEl.textContent = text.substring(0, i - 1);
					i--;
				} else {
					// Escribiendo
					nameEl.textContent = text.substring(0, i + 1);
					i++;
				}

				// Velocidades base: 80ms escribir, 40ms borrar (más rápido)
				let typingSpeed = isDeleting ? 40 : 80;

				if (!isDeleting && i === text.length) {
					// Cuando termina de escribir, espera 8 segundos antes de empezar a borrar
					typingSpeed = 4000;
					isDeleting = true;
				} else if (isDeleting && i === 0) {
					// Cuando termina de borrar, espera medio segundo antes de volver a escribir
					isDeleting = false;
					typingSpeed = 500;
				}

				setTimeout(type, typingSpeed);
			};

			// Retraso inicial antes de empezar
			setTimeout(type, 500);
		};

		// Ejecutar al cargar (compatible con View Transitions)
		document.addEventListener("astro:page-load", runTypewriter);
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", runTypewriter);
		} else {
			runTypewriter();
		}
	</script>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- SOBRE MÍ                                       -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="mx-auto max-w-3xl scroll-mt-32 px-4 py-24 sm:px-8" id="sobre-mi">
		<h2 class="title reveal mb-8 text-xl">Sobre mí</h2>

		<!-- Header de Impacto -->
		<div class="reveal mb-12">
			<h3 class="text-accent-2 text-2xl leading-tight font-bold md:text-3xl">
				Administrador de Sistemas enfocado en el despliegue de infraestructuras seguras,
				automatización y defensa perimetral.
			</h3>
		</div>

		<!-- Layout de 2 Columnas -->
		<div class="mb-16 grid grid-cols-1 gap-8 md:grid-cols-12">
			<!-- Columna Izquierda: Historia Profesional (60-70%) -->
			<div class="reveal flex flex-col gap-6 md:col-span-7 lg:col-span-8">
				<div
					class="prose prose-sm md:prose-base prose-cactus text-muted max-w-none leading-relaxed"
				>
					<p>
						¡Hola! <strong
							>Soy Pablo, Graduado en Administración de Sistemas Informáticos en Red (ASIR).</strong
						> En este sitio web encontrarás información sobre mí y el trabajo que he ido realizando durante
						mis estudios y prácticas.
					</p>
					<p>
						Me especializo en administración de redes y sistemas en entornos empresariales aplicando
						las mejores prácticas en ciberseguridad posibles.
					</p>
					<p>
						Actualmente me encuentro trabajando como Técnico Informático administrando sistemas y
						haciendo de soporte. Sigo ampliando mis conocimientos: me encuentro preparándome para
						certificaciones clave de la industria como <strong>Cisco CCNA</strong> y próximamente <strong
							>CompTIA Security+</strong
						>. Mi objetivo a medio largo plazo es consolidar mi carrera como analista e ingeniero de
						Ciberseguridad.
					</p>
				</div>

				<!-- Soft Skills minimalistas (Opcional, pero útil) -->
				<div class="mt-2 flex flex-wrap gap-3">
					<span
						class="bg-accent/10 text-accent-2 border-accent/20 inline-flex items-center gap-1.5 rounded border px-2.5 py-1 text-xs font-medium"
						>Trabajo en equipo</span
					>
					<span
						class="bg-accent/10 text-accent-2 border-accent/20 inline-flex items-center gap-1.5 rounded border px-2.5 py-1 text-xs font-medium"
						>Resiliencia</span
					>
					<span
						class="bg-accent/10 text-accent-2 border-accent/20 inline-flex items-center gap-1.5 rounded border px-2.5 py-1 text-xs font-medium"
						>Resolución de problemas</span
					>
				</div>
			</div>

			<!-- Columna Derecha: Elemento Visual de Conversión (30-40%) -->
			<div class="reveal relative md:col-span-5 lg:col-span-4">
				<div
					class="border-accent/20 hover:border-accent group bg-accent/5 relative flex h-full min-h-[280px] flex-col overflow-hidden rounded-xl border backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
				>
					<!-- Terminal Header -->
					<div class="border-accent/10 flex items-center gap-2 border-b bg-black/40 px-4 py-3">
						<div class="flex gap-1.5">
							<div class="h-3 w-3 rounded-full bg-red-500/80"></div>
							<div class="h-3 w-3 rounded-full bg-yellow-500/80"></div>
							<div class="h-3 w-3 rounded-full bg-green-500/80"></div>
						</div>
						<div class="text-muted mx-auto font-mono text-[10px]">pablo@portfolio:~</div>
					</div>
					<!-- Terminal Body -->
					<div class="relative z-20 flex flex-grow flex-col justify-center p-5 font-mono text-xs">
						<div class="text-accent-2 mb-2">
							<span class="text-emerald-400">pablo@portfolio</span>:<span class="text-blue-400"
								>~</span
							>$ whoami
						</div>
						<div
							class="text-muted mb-6 space-y-1 pl-2 opacity-80 transition-opacity group-hover:opacity-100"
						>
							<div>> SysAdmin</div>
							<div>> Técnico de Redes</div>
							<div>> Ciberseguridad</div>
						</div>

						<a
							href="/cv_pablo_calderon.pdf"
							target="_blank"
							rel="noopener noreferrer"
							class="shimmer-btn bg-accent/10 hover:bg-accent/20 text-accent border-accent/20 pointer-events-auto mt-auto flex items-center justify-center gap-2 rounded-md border px-4 py-2.5 text-xs font-semibold transition-all duration-300 hover:scale-[1.02]"
						>
							<Icon name="mdi:download" class="h-4 w-4" />
							Descargar Currículum
						</a>
					</div>
					<!-- Decorative Background Matrix/Lines -->
					<div
						class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(42,188,137,0.2)_1px,transparent_1px)] bg-[length:100%_4px] opacity-5"
					>
					</div>
				</div>
			</div>
		</div>

		<!-- Línea de tiempo de Formación (Roadmap) -->
		<div
			class="border-accent/20 hover:border-accent group bg-accent/5 relative mt-8 mb-16 overflow-hidden rounded-xl border p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg md:p-8"
		>
			<h3
				class="text-accent relative z-10 mb-8 flex items-center gap-2 text-sm font-bold tracking-widest uppercase"
			>
				<Icon name="mdi:map-marker-path" class="h-5 w-5" />
				Formación & Ruta Profesional
			</h3>

			<div class="border-accent/20 relative z-10 ml-3 space-y-8 border-l-2 md:ml-4">
				<!-- Hito 1: ASIR -->
				<div class="reveal relative pl-6 md:pl-8">
					<div
						class="absolute top-1 -left-[9px] h-4 w-4 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(42,188,137,0.8)] ring-4 ring-[#1d1f21]"
					>
					</div>
					<div class="mb-1 flex flex-col justify-between gap-1 sm:flex-row sm:items-center">
						<h4 class="text-accent-2 text-base font-semibold">Técnico Superior en ASIR</h4>
						<span
							class="inline-flex w-max items-center rounded border border-emerald-500/20 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold tracking-wider text-emerald-400 uppercase"
						>
							Completado
						</span>
					</div>
					<p class="text-muted text-sm">
						Administración de Sistemas Informáticos en Red. Base sólida en sistemas operativos,
						servicios de red y seguridad estructural.
					</p>
				</div>

				<!-- Hito 2: B2 -->
				<div class="reveal relative pl-6 md:pl-8">
					<div
						class="absolute top-1 -left-[9px] h-4 w-4 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(42,188,137,0.8)] ring-4 ring-[#1d1f21]"
					>
					</div>
					<div class="mb-1 flex flex-col justify-between gap-1 sm:flex-row sm:items-center">
						<h4 class="text-accent-2 text-base font-semibold">B2 Cambridge English</h4>
						<span
							class="inline-flex w-max items-center rounded border border-emerald-500/20 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold tracking-wider text-emerald-400 uppercase"
						>
							Completado
						</span>
					</div>
					<p class="text-muted text-sm">
						Certificación de nivel intermedio-alto de inglés, vital para la lectura y comprensión de
						documentación técnica.
					</p>
				</div>

				<!-- Hito 3: Cisco / CompTIA -->
				<div class="reveal relative pl-6 md:pl-8">
					<div
						class="absolute top-1 -left-[9px] h-4 w-4 rounded-full bg-yellow-400 shadow-[0_0_10px_rgba(250,204,21,0.8)] ring-4 ring-[#1d1f21]"
					>
					</div>
					<div class="mb-1 flex flex-col justify-between gap-1 sm:flex-row sm:items-center">
						<h4 class="text-accent-2 text-base font-semibold">Cisco CCNA & CompTIA Security+</h4>
						<span
							class="inline-flex w-max items-center rounded border border-yellow-500/20 bg-yellow-500/10 px-2 py-0.5 text-[10px] font-bold tracking-wider text-yellow-400 uppercase"
						>
							Estudiando Actual
						</span>
					</div>
					<p class="text-muted text-sm">
						Preparación activa para la certificación líder en redes (Cisco) y la certificación base
						en ciberseguridad (CompTIA).
					</p>
				</div>

				<!-- Hito 4: Ciberseguridad -->
				<div class="reveal relative pl-6 md:pl-8">
					<div
						class="absolute top-1 -left-[9px] h-4 w-4 rounded-full bg-blue-400 shadow-[0_0_10px_rgba(96,165,250,0.8)] ring-4 ring-[#1d1f21]"
					>
					</div>
					<div class="mb-1 flex flex-col justify-between gap-1 sm:flex-row sm:items-center">
						<h4 class="text-accent-2 text-base font-semibold">
							Curso Especialización Ciberseguridad
						</h4>
						<span
							class="inline-flex w-max items-center rounded border border-blue-500/20 bg-blue-500/10 px-2 py-0.5 text-[10px] font-bold tracking-wider text-blue-400 uppercase"
						>
							Meta Futura
						</span>
					</div>
					<p class="text-muted text-sm">
						Próximo paso tras consolidar las bases, con enfoque en el hacking ético, análisis
						forense y seguridad de los entornos de la información.
					</p>
				</div>
			</div>
		</div>

		<!-- ═══════════════════════════════════════════════ -->
		<!-- TECNOLOGÍAS & HERRAMIENTAS (Skillset)          -->
		<!-- ═══════════════════════════════════════════════ -->
		<div class="reveal mt-20">
			<div class="mb-10 text-center">
				<h3 class="text-accent-2 mb-2 text-xl font-bold">Tecnologías & Skills</h3>
				<p class="text-muted text-xs">
					Algunas de las tecnologías e infraestructuras con las que trabajo
				</p>
			</div>

			<!-- Habilidades flotantes -->
			<div class="mx-auto mb-16 flex max-w-2xl flex-wrap items-center justify-center gap-4.5">
				{
					skills.map((skill) => {
						const isSimpleIcon = skill.icon.startsWith("simple-icons:");
						const simpleIconSlug = isSimpleIcon ? skill.icon.replace("simple-icons:", "") : "";
						const needsInvert = ["github", "latex", "pfsense", "markdown"].includes(simpleIconSlug);

						return (
							<div
								class="floating-pill border-accent/20 bg-accent/5 hover:border-accent flex cursor-default items-center gap-2.5 rounded-full border px-4.5 py-2 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:shadow-[0_0_15px_rgba(42,188,137,0.25)]"
								style={`animation-delay: ${skill.delay}; animation-duration: ${skill.duration};`}
								data-cursor="-pointer"
							>
								{isSimpleIcon ? (
									<img
										src={`https://cdn.simpleicons.org/${simpleIconSlug}`}
										class={`h-5.5 w-5.5 object-contain ${needsInvert ? "dark:brightness-0 dark:invert" : ""}`}
										alt=""
										onerror="this.onerror=null; this.src='https://api.iconify.design/mdi/code-braces.svg?color=%232bbc8a';"
									/>
								) : (
									<Icon
										name={skill.icon}
										class="h-5.5 w-5.5"
										style={skill.color ? `color: ${skill.color}` : ""}
									/>
								)}
								<span class="text-accent-2 text-sm font-semibold">{skill.name}</span>
							</div>
						);
					})
				}
			</div>

			<div class="mb-10 text-center">
				<h3 class="text-accent-2 mb-2 text-xl font-bold">Mi stack tecnológico</h3>
				<p class="text-muted text-xs">El software y herramientas que utilizo en mi día a día</p>
			</div>

			<!-- Herramientas flotantes -->
			<div class="mx-auto flex max-w-2xl flex-wrap items-center justify-center gap-4.5">
				{
					tools.map((tool) => {
						const isSimpleIcon = tool.icon.startsWith("simple-icons:");
						const simpleIconSlug = isSimpleIcon ? tool.icon.replace("simple-icons:", "") : "";
						const needsInvert = ["github", "latex", "pfsense", "markdown"].includes(simpleIconSlug);

						return (
							<div
								class="floating-pill border-accent/20 bg-accent/5 hover:border-accent flex cursor-default items-center gap-2.5 rounded-full border px-4.5 py-2 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:shadow-[0_0_15px_rgba(42,188,137,0.25)]"
								style={`animation-delay: ${tool.delay}; animation-duration: ${tool.duration};`}
								data-cursor="-pointer"
							>
								{isSimpleIcon ? (
									<img
										src={`https://cdn.simpleicons.org/${simpleIconSlug}`}
										class={`h-5.5 w-5.5 object-contain ${needsInvert ? "dark:brightness-0 dark:invert" : ""}`}
										alt=""
										onerror="this.onerror=null; this.src='https://api.iconify.design/mdi/robot-outline.svg?color=%232bbc8a';"
									/>
								) : (
									<Icon
										name={tool.icon}
										class="h-5.5 w-5.5"
										style={tool.color ? `color: ${tool.color}` : ""}
									/>
								)}
								<span class="text-accent-2 text-sm font-semibold">{tool.name}</span>
							</div>
						);
					})
				}
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- PROYECTOS DESTACADOS                            -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="mx-auto max-w-3xl scroll-mt-32 px-4 py-24 sm:px-8" id="proyectos">
		<h2 class="title reveal mb-4 text-xl">Proyectos Destacados</h2>
		<p class="text-muted reveal mb-10 text-sm">
			Una selección de mis proyectos e implementaciones de sistemas más destacadas, con su
			respectiva documentación técnica detallada en Starlight.
		</p>

		<div class="space-y-6">
			<!-- Proyecto: TFG -->
			<article
				class="reveal border-accent/20 hover:border-accent group relative cursor-pointer overflow-hidden rounded-md border p-5 transition-all duration-150 hover:-translate-y-1 hover:shadow-lg"
				onclick="window.location.href='/proyectos/tfg-fortificacion-pyme/'"
				data-cursor="-pointer"
			>
				<div class="relative z-10">
					<div class="mb-2 flex flex-wrap items-center gap-2">
						<h3 class="text-base font-semibold">
							<a class="cactus-link" href="/proyectos/tfg-fortificacion-pyme/">
								Marco de Seguridad para PYMES
							</a>
						</h3>
						<span class="bg-accent/10 text-accent rounded-full px-2 py-0.5 text-xs font-medium">
