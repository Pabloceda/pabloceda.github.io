	<style>
		@keyframes blink {
			0%,
			100% {
				border-color: transparent;
			}
			50% {
				border-color: var(--color-accent);
			}
		}

		/* Efecto glow adaptativo según el tema (claro/oscuro) */
		.hover-glow {
			transition:
				filter 0.3s ease,
				transform 0.3s ease;
		}
		.hover-glow:hover {
			/* Sombra sutil de profundidad en modo claro */
			filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.15));
			transform: translateY(-4px);
		}
		:global([data-theme="dark"]) .hover-glow:hover {
			/* Resplandor claro e iluminado en modo oscuro */
			filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.25));
		}

		/* Animaciones de revelado (GSAP) */
		.reveal {
			opacity: 0;
			will-change: opacity, transform;
		}

		/* Efecto Glow Dinámico siguiendo el ratón */
		.glow-pointer {
			background: radial-gradient(
				600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
				rgba(42, 188, 137, 0.1),
				/* Turquesa/Verde del tema Cactus */ transparent 40%
			);
		}

		/* Animación de flotado para las píldoras de tecnologías usando 'translate' para no pisar el 'transform' del hover */
		@keyframes float {
			0%,
			100% {
				translate: 0 0;
			}
			50% {
				translate: 0 -6px;
			}
		}
		.floating-pill {
			animation: float 4s ease-in-out infinite;
			will-change: translate;
		}

		/* Botón con efecto de brillo (shimmer) */
		.shimmer-btn {
			position: relative;
			overflow: hidden;
		}
		.shimmer-btn::after {
			content: "";
			position: absolute;
			top: 0;
			left: -100%;
			width: 50%;
			height: 100%;
			background: linear-gradient(to right, transparent, rgba(42, 188, 137, 0.25), transparent);
			transform: skewX(-25deg);
			animation: shimmer 3s infinite;
		}
		@keyframes shimmer {
			0%,
			65% {
				left: -100%;
			}
			100% {
				left: 200%;
			}
		}
	</style>

	<script>
		import { gsap } from "gsap";
		import { ScrollTrigger } from "gsap/ScrollTrigger";

		gsap.registerPlugin(ScrollTrigger);

		const setupInteractions = () => {
			// 1. Animación del Hero Subtitle y Botones CTA (Entrada secuencial)
			gsap.to(".hero-subtitle span, .hero-cta a", {
				opacity: 1,
				y: 0,
				duration: 0.8,
				stagger: 0.15,
				ease: "power3.out",
				delay: 0.2, // Entra nada más cargar la página
			});

			// 2. Configurar GSAP ScrollTrigger con Batch para animaciones en cascada (.reveal)
			ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

			ScrollTrigger.batch(".reveal", {
				onEnter: (elements) => {
					gsap.fromTo(
						elements,
						{ opacity: 0, y: 35 },
						{
							opacity: 1,
							y: 0,
							duration: 0.4,
							stagger: 0.08,
							ease: "power2.out",
							overwrite: true,
						},
					);
				},
				once: true,
			});

			// 2. Configurar Glow Effect en tarjetas de proyectos y Bento grid
			const glowCards = document.querySelectorAll(".glow-card");
			glowCards.forEach((card) => {
				const handleMouseMove = (e: MouseEvent) => {
					const rect = card.getBoundingClientRect();
					const x = e.clientX - rect.left;
					const y = e.clientY - rect.top;
					(card as HTMLElement).style.setProperty("--mouse-x", `${x}px`);
					(card as HTMLElement).style.setProperty("--mouse-y", `${y}px`);
				};

				card.removeEventListener("mousemove", handleMouseMove as any);
				card.addEventListener("mousemove", handleMouseMove as any);
			});
		};

		// Ejecutar interacciones (Compatible con View Transitions / Speculation Rules)
		document.addEventListener("astro:page-load", setupInteractions);
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", setupInteractions);
		} else {
			setupInteractions();
		}

		// Refrescar ScrollTrigger en cambios de redimensión o carga completa de assets
		window.addEventListener("load", () => ScrollTrigger.refresh());
		window.addEventListener("resize", () => ScrollTrigger.refresh());
	</script>
